# ─── SQLite Database ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Python ──────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# ─── Environment Variables (NEVER commit secrets) ────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Next.js ─────────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/

# ─── Node / npm ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Yarn v2+
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── TypeScript build cache ───────────────────────────────────────────────────────
*.tsbuildinfo

# ─── OS & Editor junk ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/settings.json
.vscode/launch.json
.idea/

# ─── Misc ────────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.pem
