# ---- Required ----
# Clerk issuer domain, e.g. stable-rattler-9254.clerk.accounts.dev
CLERK_ISSUER_DOMAIN=
# Exact frontend origin(s), comma separated, no trailing slash. e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=
# Postgres in production (Render's postgres:// scheme is accepted). Falls back to SQLite when unset.
DATABASE_URL=

# Signs join tickets. Use a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SECRET_KEY=

# ---- Optional ----
# Shared files (chat attachments). Deleted when a meeting ends.
UPLOAD_DIR=
MAX_UPLOAD_MB=10
# Regex of extra allowed origins, e.g. Vercel previews: https://your-app-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# WebRTC relay. Without TURN, users behind symmetric NAT / corporate firewalls cannot connect.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Either static credentials...
TURN_USERNAME=
TURN_CREDENTIAL=
# ...or a coturn static-auth-secret (short-lived credentials are minted per request)
TURN_SECRET=
WS_IDLE_TIMEOUT_SECONDS=45
