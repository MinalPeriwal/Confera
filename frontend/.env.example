# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public URL of the FastAPI backend, reachable from the browser. Must be https:// in production
# (the WebSocket URL is derived from it: https -> wss). No trailing slash.
NEXT_PUBLIC_BACKEND_URL=

# Optional: public URL of this web app, used when building shareable meeting links.
# Defaults to the browser's current origin, which is almost always what you want.
NEXT_PUBLIC_APP_URL=

# Optional fallback relay if the backend does not serve /api/ice-servers
# (prefer configuring TURN_* on the backend instead).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional: only for self-hosting behind ONE domain with Next.js rewrites. Leave empty on Vercel.
BACKEND_URL=
